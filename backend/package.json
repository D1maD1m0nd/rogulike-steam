{
  "name": "@steam-draft/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd .. && bun --env-file=.env --watch backend/src/main.ts",
    "build": "bun build src/main.ts --target=bun --packages=external --outdir=dist",
    "start": "bun --env-file=../.env dist/main.js",
    "prisma:cli": "bun --env-file=../.env x --bun prisma",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/adapter-libsql": "7.10.1",
    "@prisma/client": "7.10.1",
    "@steam-draft/contracts": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "entities": "^6.0.1",
    "express": "^5.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/express": "^5.0.0",
    "prisma": "7.10.1"
  }
}
